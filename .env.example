# Mettle environment.
#
# With none of these set, the app runs entirely on the local adapter: content is
# bundled, progress is stored on-device, and the Arena is scored by the offline
# heuristic. Everything works, including a full three-round spar.
#
# Setting BOTH Supabase values switches the repository to the Supabase adapter.
# There is no partial mode: whichever adapter is selected satisfies the whole
# interface.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Set with `supabase secrets set`, never in this file and
# never with an EXPO_PUBLIC_ prefix: anything EXPO_PUBLIC_ is compiled into the
# app bundle and is readable by anyone who downloads it.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ARENA_MODEL=claude-opus-5
#   supabase secrets set ALLOWED_ORIGIN=https://your.app
